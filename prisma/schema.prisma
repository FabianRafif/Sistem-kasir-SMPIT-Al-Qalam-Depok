generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
}

enum PaymentMethod {
  CASH
  QRIS
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  FAILED
}

enum MovementType {
  INITIAL
  IN
  OUT
  ADJUSTMENT
  SALE
  RETURN
  CANCEL
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum QrisMode {
  STATIC
  DYNAMIC
}

model User {
  id           String         @id @default(uuid())
  name         String         @db.VarChar(100)
  username     String         @unique @db.VarChar(50)
  email        String?        @unique @db.VarChar(100)
  passwordHash String         @map("password_hash") @db.VarChar(255)
  role         Role           @default(CASHIER)
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  sales          Sale[]
  stockMovements StockMovement[]
  auditLogs      AuditLog[]
  shifts         CashierShift[]

  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id           String    @id @default(uuid())
  sku          String    @unique @db.VarChar(50)
  barcode      String?   @unique @db.VarChar(100)
  name         String    @db.VarChar(255)
  categoryId   String    @map("category_id")
  unit         String    @default("pcs") @db.VarChar(20)
  costPrice    Decimal   @default(0.00) @map("cost_price") @db.Decimal(12, 2)
  sellingPrice Decimal   @map("selling_price") @db.Decimal(12, 2)
  stockQty     Int       @default(0) @map("stock_qty")
  minimumStock Int       @default(5) @map("minimum_stock")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  category       Category        @relation(fields: [categoryId], references: [id])
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@index([name])
  @@index([barcode])
  @@index([sku])
  @@index([categoryId])
  @@map("products")
}

model Sale {
  id             String        @id @default(uuid())
  receiptNumber  String        @unique @map("receipt_number") @db.VarChar(50)
  userId         String        @map("user_id")
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  grandTotal     Decimal       @map("grand_total") @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @map("payment_method")
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  cashReceived   Decimal?      @map("cash_received") @db.Decimal(12, 2)
  changeAmount   Decimal?      @map("change_amount") @db.Decimal(12, 2)
  notes          String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")
  paidAt         DateTime?     @map("paid_at")
  cancelledAt    DateTime?     @map("cancelled_at")

  user     User       @relation(fields: [userId], references: [id])
  items    SaleItem[]
  payments Payment[]

  @@index([userId])
  @@index([receiptNumber])
  @@index([createdAt])
  @@index([paymentStatus])
  @@map("sales")
}

model SaleItem {
  id              String   @id @default(uuid())
  saleId          String   @map("sale_id")
  productId       String   @map("product_id")
  productName     String   @map("product_name") @db.VarChar(255)
  skuSnapshot     String   @map("sku_snapshot") @db.VarChar(50)
  barcodeSnapshot String?  @map("barcode_snapshot") @db.VarChar(100)
  quantity        Int
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 2)
  unitCost        Decimal  @default(0.00) @map("unit_cost") @db.Decimal(12, 2)
  lineTotal       Decimal  @map("line_total") @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model StockMovement {
  id             String       @id @default(uuid())
  productId      String       @map("product_id")
  userId         String       @map("user_id")
  movementType   MovementType @map("movement_type")
  quantityChange Int          @map("quantity_change")
  referenceType  String?      @map("reference_type") @db.VarChar(50)
  referenceId    String?      @map("reference_id") @db.VarChar(100)
  reason         String?      @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
  @@map("stock_movements")
}

model Payment {
  id                String        @id @default(uuid())
  saleId            String        @map("sale_id")
  provider          String        @default("SYSTEM") @db.VarChar(50)
  providerReference String?       @map("provider_reference") @db.VarChar(100)
  paymentMethod     PaymentMethod @map("payment_method")
  amount            Decimal       @db.Decimal(12, 2)
  status            PaymentStatus @default(PENDING)
  idempotencyKey    String?       @unique @map("idempotency_key") @db.VarChar(100)
  qrCodeData        String?       @map("qr_code_data") @db.Text
  paidAt            DateTime?     @map("paid_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([providerReference])
  @@map("payments")
}

model PaymentWebhookEvent {
  id               String    @id @default(uuid())
  provider         String    @db.VarChar(50)
  eventId          String    @unique @map("event_id") @db.VarChar(100)
  payloadHash      String    @map("payload_hash") @db.VarChar(64)
  payload          String?   @db.Text
  processingStatus String    @default("PROCESSED") @map("processing_status") @db.VarChar(50)
  receivedAt       DateTime  @default(now()) @map("received_at")
  processedAt      DateTime? @map("processed_at")

  @@index([provider, eventId])
  @@map("payment_webhook_events")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  details    String?  @db.Text
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model StoreSetting {
  id               String   @id @default("default")
  storeName        String   @default("Kantin & Minimarket SMPIT Al Qalam") @map("store_name") @db.VarChar(150)
  schoolName       String   @default("SMPIT Al Qalam") @map("school_name") @db.VarChar(150)
  address          String?  @db.Text
  phone            String?  @db.VarChar(50)
  receiptFooter    String?  @map("receipt_footer") @db.Text
  logoPath         String   @default("/logo-alqalam.png") @map("logo_path") @db.VarChar(255)
  timezone         String   @default("Asia/Jakarta") @db.VarChar(50)
  printerPaperSize String   @default("58mm") @map("printer_paper_size") @db.VarChar(10)
  qrisMode         QrisMode @default(DYNAMIC) @map("qris_mode")
  qrisStaticImage  String?  @map("qris_static_image") @db.LongText
  qrisPureImage    String?  @map("qris_pure_image") @db.LongText
  qrisPayload      String?  @map("qris_payload") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

model CashierShift {
  id                  String      @id @default(uuid())
  userId              String      @map("user_id")
  startTime           DateTime    @default(now()) @map("start_time")
  endTime             DateTime?   @map("end_time")
  startingCash        Decimal     @default(0.00) @map("starting_cash") @db.Decimal(12, 2)
  endingCashActual    Decimal?    @map("ending_cash_actual") @db.Decimal(12, 2)
  endingCashExpected  Decimal?    @map("ending_cash_expected") @db.Decimal(12, 2)
  cashSalesTotal      Decimal     @default(0.00) @map("cash_sales_total") @db.Decimal(12, 2)
  qrisSalesTotal      Decimal     @default(0.00) @map("qris_sales_total") @db.Decimal(12, 2)
  status              ShiftStatus @default(OPEN)
  notes               String?     @db.Text
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("cashier_shifts")
}
